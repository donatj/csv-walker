{
	"name": "csv-walker",
	"version": "0.2.0",
	"description": "A tiny CSV parser for browsers and Node.js.",
	"keywords": [
		"csv",
		"generator",
		"parser",
		"stream",
		"tsv"
	],
	"homepage": "https://github.com/donatj/csv-walker#readme",
	"bugs": "https://github.com/donatj/csv-walker/issues",
	"license": "MIT",
	"author": {
		"name": "Jesse G. Donat",
		"email": "donatj@gmail.com",
		"url": "https://donatstudios.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/donatj/csv-walker.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": "./dist/index.js",
	"scripts": {
		"build": "tsc",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint",
		"test": "npm run build && node --test test/*.test.js",
		"test:coverage": "tsc --sourceMap && c8 --reporter=lcov --reporter=text node --test test/*.test.js"
	},
	"devDependencies": {
		"c8": "^12.0.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=20"
	}
}
